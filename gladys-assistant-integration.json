{
  "manifest_version": 1,
  "type": "device",
  "name": "STM Montréal",
  "description": {
    "en": "Next STM bus departures, metro line status and BIXI stations in Montréal.",
    "fr": "Prochains passages d'autobus STM, état du métro et stations BIXI à Montréal."
  },
  "version": "0.2.0",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-stm:0.2.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/gladys-stm/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Get started in 2 minutes",
        "fr": "Démarrer en 2 minutes"
      },
      "description": {
        "en": "1. Check that your house has an address in Gladys (Settings → Houses). 2. Save this page. 3. Open the “Discover” tab of this integration and press “Add” on the stops and BIXI stations near your home. That's it: you get the scheduled bus times and the BIXI bikes right away. An STM key (optional, free) adds real time and the metro status.",
        "fr": "1. Vérifiez que votre maison a une adresse dans Gladys (Paramètres → Maisons). 2. Enregistrez cette page. 3. Ouvrez l’onglet « Découverte » de cette intégration et cliquez sur « Ajouter » sur les arrêts et stations BIXI près de chez vous. C’est tout : vous avez tout de suite les horaires prévus des autobus et les vélos BIXI. Une clé STM (facultative, gratuite) ajoute le temps réel et l’état du métro."
      },
      "links": [
        {
          "url": "https://github.com/LM1LC3N7/gladys-stm/blob/main/docs/fr.md",
          "label": {
            "en": "Step-by-step guide",
            "fr": "Guide pas à pas"
          }
        },
        {
          "url": "https://transitous.org/sources/",
          "label": {
            "en": "Timetable data (Transitous)",
            "fr": "Données des horaires (Transitous)"
          }
        }
      ]
    },
    {
      "key": "nearby",
      "type": "section",
      "label": {
        "en": "Near my home",
        "fr": "Près de chez moi"
      },
      "description": {
        "en": "How many of the closest bus stops (within 600 m) and BIXI stations (within 1 km) are proposed in the “Discover” tab. 0 turns the suggestion off.",
        "fr": "Combien d’arrêts d’autobus (à moins de 600 m) et de stations BIXI (à moins de 1 km) parmi les plus proches sont proposés dans l’onglet « Découverte ». 0 désactive la suggestion."
      }
    },
    {
      "key": "nearby_bus_stops",
      "type": "number",
      "label": {
        "en": "Bus stops near my home",
        "fr": "Arrêts près de chez moi"
      },
      "required": false,
      "default": 3,
      "min": 0,
      "max": 8
    },
    {
      "key": "nearby_bixi_stations",
      "type": "number",
      "label": {
        "en": "BIXI stations near my home",
        "fr": "Stations BIXI près de chez moi"
      },
      "required": false,
      "default": 2,
      "min": 0,
      "max": 8
    },
    {
      "key": "account",
      "type": "section",
      "label": {
        "en": "Real time and metro (optional)",
        "fr": "Temps réel et métro (facultatif)"
      },
      "description": {
        "en": "Without a key you get the scheduled times. With a free STM key you get the real-time bus predictions and the status of the metro lines. Getting one takes 5 minutes: follow the step-by-step guide.",
        "fr": "Sans clé, vous avez les horaires prévus. Avec une clé STM gratuite, vous avez les prédictions en temps réel des autobus et l’état des lignes de métro. L’obtenir prend 5 minutes : suivez le guide pas à pas."
      },
      "links": [
        {
          "url": "https://github.com/LM1LC3N7/gladys-stm/blob/main/docs/fr.md#obtenir-la-clé-dapi-stm-5-minutes",
          "label": {
            "en": "How to get the key",
            "fr": "Comment obtenir la clé"
          }
        },
        {
          "url": "https://portail.developpeurs.stm.info/apihub",
          "label": {
            "en": "STM developer portal",
            "fr": "Portail développeurs STM"
          }
        }
      ]
    },
    {
      "key": "stm_api_key",
      "type": "secret",
      "label": {
        "en": "STM API key",
        "fr": "Clé d'API STM"
      },
      "description": {
        "en": "The key of your application on the STM developer portal (the shared secret is not needed).",
        "fr": "La clé de votre application sur le portail développeurs de la STM (le secret partagé n'est pas nécessaire)."
      },
      "required": false
    },
    {
      "key": "watch_metro",
      "type": "boolean",
      "label": {
        "en": "Watch the metro",
        "fr": "Surveiller le métro"
      },
      "description": {
        "en": "Creates a \"STM metro\" device with the status of the green, orange, yellow and blue lines.",
        "fr": "Crée un appareil « Métro STM » avec l'état des lignes verte, orange, jaune et bleue."
      },
      "required": false,
      "default": true
    },
    {
      "key": "schedule_without_key",
      "type": "boolean",
      "label": {
        "en": "Scheduled times without a key",
        "fr": "Horaires prévus sans clé"
      },
      "description": {
        "en": "Without an STM key, show the scheduled bus times (from the free Transitous service).",
        "fr": "Sans clé STM, afficher les horaires prévus des autobus (via le service gratuit Transitous)."
      },
      "required": false,
      "default": true
    },
    {
      "key": "watch",
      "type": "section",
      "label": {
        "en": "Other stops and stations (optional)",
        "fr": "Autres arrêts et stations (facultatif)"
      },
      "description": {
        "en": "To watch a stop that is not near your home (work, school…): type its five-digit code, written on the stop sign, or find it with the “Find a bus stop” button at the bottom of this page.",
        "fr": "Pour surveiller un arrêt qui n’est pas près de chez vous (travail, école…) : tapez son code à cinq chiffres, inscrit sur le panneau de l’arrêt, ou trouvez-le avec le bouton « Chercher un arrêt » en bas de cette page."
      }
    },
    {
      "key": "stops",
      "type": "string",
      "label": {
        "en": "Bus stops",
        "fr": "Arrêts d'autobus"
      },
      "description": {
        "en": "Stop codes. Optional route filter after @ and custom name after : — e.g. \"52743, 51003@24:Bus to work, 61503@69|469\".",
        "fr": "Codes d'arrêt. Filtre de lignes optionnel après @ et nom personnalisé après : — ex. « 52743, 51003@24:Bus du travail, 61503@69|469 »."
      },
      "required": false,
      "placeholder": {
        "en": "52743, 51003@24:Bus to work",
        "fr": "52743, 51003@24:Bus du travail"
      }
    },
    {
      "key": "bixi_stations",
      "type": "string",
      "label": {
        "en": "BIXI stations",
        "fr": "Stations BIXI"
      },
      "description": {
        "en": "BIXI station ids, with an optional custom name after : — e.g. \"1, 42:Station at home\".",
        "fr": "Identifiants de stations BIXI, avec un nom personnalisé optionnel après : — ex. « 1, 42:Station de la maison »."
      },
      "required": false,
      "placeholder": {
        "en": "1, 42:Station at home",
        "fr": "1, 42:Station de la maison"
      }
    },
    {
      "key": "refresh",
      "type": "section",
      "label": {
        "en": "Advanced",
        "fr": "Avancé"
      },
      "description": {
        "en": "The defaults suit almost everyone. With an STM key, one read of the bus feed serves every stop: about 2,200 of your 10,000 daily STM requests.",
        "fr": "Les valeurs par défaut conviennent à presque tout le monde. Avec une clé STM, une seule lecture du flux autobus sert tous les arrêts : environ 2 200 de vos 10 000 requêtes STM quotidiennes."
      }
    },
    {
      "key": "departures_poll_frequency",
      "type": "number",
      "label": {
        "en": "Departures refresh interval (s)",
        "fr": "Rafraîchissement des passages (s)"
      },
      "description": {
        "en": "How often the bus departures are refreshed, in seconds.",
        "fr": "Fréquence de rafraîchissement des passages d'autobus, en secondes."
      },
      "required": false,
      "default": 60,
      "min": 30,
      "max": 3600
    },
    {
      "key": "metro_poll_frequency",
      "type": "number",
      "label": {
        "en": "Metro refresh interval (s)",
        "fr": "Rafraîchissement du métro (s)"
      },
      "description": {
        "en": "How often the metro status is refreshed, in seconds.",
        "fr": "Fréquence de rafraîchissement de l'état du métro, en secondes."
      },
      "required": false,
      "default": 120,
      "min": 30,
      "max": 3600
    },
    {
      "key": "bixi_poll_frequency",
      "type": "number",
      "label": {
        "en": "BIXI refresh interval (s)",
        "fr": "Rafraîchissement BIXI (s)"
      },
      "description": {
        "en": "How often the BIXI stations are refreshed, in seconds.",
        "fr": "Fréquence de rafraîchissement des stations BIXI, en secondes."
      },
      "required": false,
      "default": 120,
      "min": 30,
      "max": 3600
    },
    {
      "key": "max_departures",
      "type": "number",
      "label": {
        "en": "Departures per stop",
        "fr": "Passages par arrêt"
      },
      "description": {
        "en": "How many upcoming departures each stop device exposes as features.",
        "fr": "Nombre de prochains passages exposés en fonctionnalités par arrêt."
      },
      "required": false,
      "default": 3,
      "min": 1,
      "max": 5
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the values",
        "fr": "Langue des valeurs"
      },
      "description": {
        "en": "Language of the feature names and of the texts published (metro messages, statuses).",
        "fr": "Langue des noms de fonctionnalités et des textes publiés (messages du métro, états)."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_stm_api",
      "label": {
        "en": "Test the STM API key",
        "fr": "Tester la clé d'API STM"
      },
      "timeout_seconds": 30
    },
    {
      "key": "search_stops",
      "label": {
        "en": "Find a bus stop",
        "fr": "Chercher un arrêt"
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "label": {
            "en": "Stop name or street corner",
            "fr": "Nom de l’arrêt ou intersection"
          },
          "placeholder": {
            "en": "Sherbrooke Papineau",
            "fr": "Sherbrooke Papineau"
          },
          "required": true
        }
      ]
    },
    {
      "key": "search_bixi_stations",
      "label": {
        "en": "Find a BIXI station",
        "fr": "Chercher une station BIXI"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "label": {
            "en": "Station name",
            "fr": "Nom de la station"
          },
          "placeholder": {
            "en": "Berri",
            "fr": "Berri"
          },
          "required": true
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "departure_approaching",
      "label": {
        "en": "STM bus approaching",
        "fr": "Autobus STM imminent"
      },
      "description": {
        "en": "A bus of a watched stop is now less than the chosen number of minutes away.",
        "fr": "Un autobus d'un arrêt surveillé passe désormais dans moins du nombre de minutes choisi."
      },
      "fields": [
        {
          "key": "stop",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Bus stop",
            "fr": "Arrêt"
          },
          "required": true
        },
        {
          "key": "threshold",
          "type": "select",
          "label": {
            "en": "Minutes before departure",
            "fr": "Minutes avant le passage"
          },
          "required": true,
          "options": [
            {
              "value": "1",
              "label": {
                "en": "1 minute",
                "fr": "1 minute"
              }
            },
            {
              "value": "2",
              "label": {
                "en": "2 minutes",
                "fr": "2 minutes"
              }
            },
            {
              "value": "3",
              "label": {
                "en": "3 minutes",
                "fr": "3 minutes"
              }
            },
            {
              "value": "5",
              "label": {
                "en": "5 minutes",
                "fr": "5 minutes"
              }
            },
            {
              "value": "10",
              "label": {
                "en": "10 minutes",
                "fr": "10 minutes"
              }
            },
            {
              "value": "15",
              "label": {
                "en": "15 minutes",
                "fr": "15 minutes"
              }
            }
          ]
        },
        {
          "key": "route",
          "type": "string",
          "label": {
            "en": "Route (empty: any)",
            "fr": "Ligne (vide : toutes)"
          },
          "placeholder": {
            "en": "24",
            "fr": "24"
          }
        }
      ],
      "variables": [
        {
          "key": "stop_name",
          "type": "string",
          "label": {
            "en": "Stop",
            "fr": "Arrêt"
          }
        },
        {
          "key": "route",
          "type": "string",
          "label": {
            "en": "Route",
            "fr": "Ligne"
          }
        },
        {
          "key": "minutes",
          "type": "number",
          "label": {
            "en": "Minutes to wait",
            "fr": "Minutes d'attente"
          }
        }
      ]
    },
    {
      "key": "metro_status_changed",
      "label": {
        "en": "STM metro status changed",
        "fr": "État du métro STM modifié"
      },
      "description": {
        "en": "A metro line was disrupted, got back to normal, or received a service notice.",
        "fr": "Une ligne de métro a été perturbée, est revenue à la normale ou a reçu un avis de service."
      },
      "fields": [
        {
          "key": "line",
          "type": "multi_select",
          "label": {
            "en": "Lines",
            "fr": "Lignes"
          },
          "options": [
            {
              "value": "1",
              "label": {
                "en": "Green line",
                "fr": "Ligne verte"
              }
            },
            {
              "value": "2",
              "label": {
                "en": "Orange line",
                "fr": "Ligne orange"
              }
            },
            {
              "value": "4",
              "label": {
                "en": "Yellow line",
                "fr": "Ligne jaune"
              }
            },
            {
              "value": "5",
              "label": {
                "en": "Blue line",
                "fr": "Ligne bleue"
              }
            }
          ]
        },
        {
          "key": "event",
          "type": "multi_select",
          "label": {
            "en": "Events",
            "fr": "Événements"
          },
          "options": [
            {
              "value": "disrupted",
              "label": {
                "en": "Disrupted",
                "fr": "Perturbée"
              }
            },
            {
              "value": "restored",
              "label": {
                "en": "Back to normal",
                "fr": "Retour à la normale"
              }
            },
            {
              "value": "notice",
              "label": {
                "en": "Service notice",
                "fr": "Avis de service"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "line_name",
          "type": "string",
          "label": {
            "en": "Line",
            "fr": "Ligne"
          }
        },
        {
          "key": "event",
          "type": "string",
          "label": {
            "en": "Event",
            "fr": "Événement"
          }
        },
        {
          "key": "message",
          "type": "string",
          "label": {
            "en": "STM message",
            "fr": "Message STM"
          }
        }
      ]
    },
    {
      "key": "bixi_station_changed",
      "label": {
        "en": "BIXI station changed",
        "fr": "Station BIXI modifiée"
      },
      "description": {
        "en": "A watched BIXI station ran out of bikes or docks, got some back, or changed service.",
        "fr": "Une station BIXI surveillée n'a plus de vélos ou de places, en retrouve, ou change de service."
      },
      "fields": [
        {
          "key": "station",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "BIXI station",
            "fr": "Station BIXI"
          },
          "required": true
        },
        {
          "key": "event",
          "type": "multi_select",
          "label": {
            "en": "Events",
            "fr": "Événements"
          },
          "options": [
            {
              "value": "no_bike",
              "label": {
                "en": "No bike left",
                "fr": "Plus aucun vélo"
              }
            },
            {
              "value": "bikes_back",
              "label": {
                "en": "Bikes back",
                "fr": "Vélos de retour"
              }
            },
            {
              "value": "no_dock",
              "label": {
                "en": "No free dock",
                "fr": "Plus aucune place"
              }
            },
            {
              "value": "docks_back",
              "label": {
                "en": "Docks back",
                "fr": "Places de retour"
              }
            },
            {
              "value": "out_of_service",
              "label": {
                "en": "Out of service",
                "fr": "Hors service"
              }
            },
            {
              "value": "back_in_service",
              "label": {
                "en": "Back in service",
                "fr": "Remise en service"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "station_name",
          "type": "string",
          "label": {
            "en": "Station",
            "fr": "Station"
          }
        },
        {
          "key": "event",
          "type": "string",
          "label": {
            "en": "Event",
            "fr": "Événement"
          }
        },
        {
          "key": "bikes",
          "type": "number",
          "label": {
            "en": "Bikes",
            "fr": "Vélos"
          }
        },
        {
          "key": "electric_bikes",
          "type": "number",
          "label": {
            "en": "Electric bikes",
            "fr": "Vélos électriques"
          }
        },
        {
          "key": "docks",
          "type": "number",
          "label": {
            "en": "Free docks",
            "fr": "Places libres"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_next_departures",
      "label": {
        "en": "Read the next STM buses",
        "fr": "Lire les prochains autobus STM"
      },
      "description": {
        "en": "Reads the next departures of a watched bus stop, now.",
        "fr": "Lit maintenant les prochains passages d'un arrêt surveillé."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "stop",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Bus stop",
            "fr": "Arrêt"
          },
          "required": true
        },
        {
          "key": "route",
          "type": "string",
          "label": {
            "en": "Route (empty: any)",
            "fr": "Ligne (vide : toutes)"
          },
          "placeholder": {
            "en": "24",
            "fr": "24"
          }
        }
      ],
      "outputs": [
        {
          "key": "route",
          "type": "string",
          "label": {
            "en": "Route",
            "fr": "Ligne"
          }
        },
        {
          "key": "minutes",
          "type": "number",
          "label": {
            "en": "Minutes to wait",
            "fr": "Minutes d'attente"
          }
        },
        {
          "key": "following_minutes",
          "type": "number",
          "label": {
            "en": "Minutes to the following one",
            "fr": "Minutes jusqu'au suivant"
          }
        },
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Departure board",
            "fr": "Tableau des passages"
          }
        },
        {
          "key": "count",
          "type": "number",
          "label": {
            "en": "Upcoming departures",
            "fr": "Passages à venir"
          }
        }
      ]
    },
    {
      "key": "get_metro_status",
      "label": {
        "en": "Read an STM metro line status",
        "fr": "État d'une ligne de métro"
      },
      "description": {
        "en": "Reads the current status of one metro line, now.",
        "fr": "Lit maintenant l'état actuel d'une ligne de métro."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "line",
          "type": "select",
          "label": {
            "en": "Line",
            "fr": "Ligne"
          },
          "required": true,
          "options": [
            {
              "value": "1",
              "label": {
                "en": "Green line",
                "fr": "Ligne verte"
              }
            },
            {
              "value": "2",
              "label": {
                "en": "Orange line",
                "fr": "Ligne orange"
              }
            },
            {
              "value": "4",
              "label": {
                "en": "Yellow line",
                "fr": "Ligne jaune"
              }
            },
            {
              "value": "5",
              "label": {
                "en": "Blue line",
                "fr": "Ligne bleue"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "line_name",
          "type": "string",
          "label": {
            "en": "Line",
            "fr": "Ligne"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "Status code",
            "fr": "Code d'état"
          }
        },
        {
          "key": "status_label",
          "type": "string",
          "label": {
            "en": "Status",
            "fr": "État"
          }
        },
        {
          "key": "message",
          "type": "string",
          "label": {
            "en": "STM message",
            "fr": "Message STM"
          }
        },
        {
          "key": "normal",
          "type": "boolean",
          "label": {
            "en": "Normal service",
            "fr": "Service normal"
          }
        }
      ]
    }
